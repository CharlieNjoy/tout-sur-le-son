---
import Layout from "../layouts/Layout.astro";

// Une ligne par carte : ajoutez-en au fur et à mesure que le site grandit
const pages = [
  { titre: "Apprendre", texte: "Cours par matière et par niveau.", href: "/cours" },
  { titre: "Essayer", texte: "Applications, jeux et exercices.", href: "/applications" },
  { titre: "S'entraîner", texte: "Quiz BTS et exercices d'oreille.", href: "/entrainement" },
  { titre: "Rechercher", texte: "Consulter les ressources.", href: "/ressources" },
];
---
<Layout title="Que souhaitez-vous faire ?">
  <h1>Que souhaitez-vous faire ?</h1>

  <div class="grille">
    {pages.map((p) => (
      <a class="carte" href={p.href}>
        <span class="titre">{p.titre}</span>
        <span class="sous-titre">{p.texte}</span>
        <span class="fleche">→</span>
      </a>
    ))}
  </div>

  <style>
    .grille {
      display: grid; gap: 1.25rem; margin-top: 2rem;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    }
    .carte {
      display: flex; flex-direction: column; gap: .4rem;
      padding: 1.5rem; border: 1px solid var(--line); border-radius: 12px;
      text-decoration: none; color: var(--fg);
      transition: border-color .2s, box-shadow .2s;
    }
    .carte:hover { border-color: var(--accent); box-shadow: 0 4px 16px rgba(0, 0, 0, .3); }
    .titre { font-size: 1.2rem; }
    .sous-titre { color: var(--muted); font-size: .95rem; line-height: 1.5; }
    .fleche { margin-top: auto; padding-top: .75rem; color: var(--accent); transition: transform .2s; }
    .carte:hover .fleche { transform: translateX(4px); }
  </style>

  <script>
    import gsap from "gsap";
    gsap.fromTo(".carte",
      { y: 20, opacity: 0 },
      { y: 0, opacity: 1, duration: .6, stagger: .08, ease: "power2.out" });
  </script>
</Layout>
