---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Accueil">
  <section class="hero">
    <h1 class="titre">Tout sur le son</h1>
    <p class="sous muted">Par Charlie Février</p>
    <a href="/services" class="bouton">Découvrir</a>
  </section>

  <style>
    .hero { min-height: 60vh; display: grid; place-content: center; text-align: center; }
    .bouton {
      display: inline-block; margin-top: 1.5rem; padding: .8rem 1.6rem;
      border: 1px solid var(--accent); color: var(--accent);
      text-decoration: none; border-radius: 999px; transition: background .2s;
    }
    .bouton:hover { background: rgba(110, 231, 255, .1); }
  </style>

  <style is:global>
    .onde {
      position: fixed; width: 20px; height: 20px;
      border: 2px solid var(--accent); border-radius: 50%;
      pointer-events: none; transform: translate(-50%, -50%);
    }
  </style>

  <script>
    import gsap from "gsap";

    // Apparition du titre
    gsap.fromTo(".titre", { y: 40, opacity: 0 }, { y: 0, opacity: 1, duration: 1.2, ease: "power3.out" });
    gsap.fromTo([".sous", ".bouton"], { y: 20, opacity: 0 }, { y: 0, opacity: 1, delay: .5, duration: 1, stagger: .2 });

    // Ondes sonores au clic
    document.addEventListener("click", (e) => {
      for (let i = 0; i < 3; i++) {
        const o = document.createElement("div");
        o.className = "onde";
        o.style.left = e.clientX + "px";
        o.style.top = e.clientY + "px";
        document.body.appendChild(o);
        gsap.to(o, {
          width: 400, height: 400, opacity: 0, duration: 1.6,
          delay: i * .2, ease: "power2.out", onComplete: () => o.remove(),
        });
      }
    });
  </script>
</Layout>
