<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width" />
  <title>Test</title>
</head>
<body>
  <h1 class="titre">Son Clair</h1>
  <p class="sous">Cliquez n'importe où</p>

  <style is:global>
    body { margin:0; height:100vh; display:grid; place-content:center; text-align:center;
           background:#0e0e10; color:#f2f2f2; font-family:system-ui; overflow:hidden; cursor:crosshair; }
    h1 { font-size:clamp(2.5rem,8vw,6rem); margin:0; font-weight:300; letter-spacing:.05em; }
    .sous { opacity:.6; }
    .onde { position:fixed; width:20px; height:20px; border:2px solid #6ee7ff;
            border-radius:50%; pointer-events:none; transform:translate(-50%,-50%); }
  </style>

  <script>
    import gsap from "gsap";

    gsap.from(".titre", { y:40, opacity:0, duration:1.2, ease:"power3.out" });
    gsap.from(".sous", { opacity:0, delay:0.6, duration:1 });

    document.addEventListener("click", (e) => {
      for (let i = 0; i < 3; i++) {
        const o = document.createElement("div");
        o.className = "onde";
        o.style.left = e.clientX + "px";
        o.style.top = e.clientY + "px";
        document.body.appendChild(o);
        gsap.to(o, { width:400, height:400, opacity:0, duration:1.6,
                     delay:i*0.2, ease:"power2.out", onComplete:() => o.remove() });
      }
    });
  </script>
</body>
</html>