---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import { matieres } from "../data/cours.js";
import { infosLecon } from "../data/lecons.js";

const entreesLecons = await getCollection("lecons");

// Numérote en continu les sous-chapitres d'un chapitre, colonne de niveau après colonne
// de niveau (ex. 2.1, 2.2 en débutant, puis 2.3, 2.4… en intermédiaire).
function numeroterChapitre(ch) {
  const numeros = new Map();
  let n = 0;
  for (const sousChapitres of Object.values(ch.niveaux)) {
    for (const titre of sousChapitres) numeros.set(titre, ++n);
  }
  return numeros;
}
---
<Layout title="Cours">

  <!-- ===== CHOIX DE LA MATIÈRE ===== -->
  <div id="choix-matiere">
    <h1>Apprendre</h1>
    <p class="etape muted">Choisissez une matière</p>
    <div class="choix">
      {matieres.map((m) => (
        <button class="carte matiere" data-matiere={m.id}>
          <span class="titre">{m.nom}</span>
          <span class="sous-titre">{m.description}</span>
        </button>
      ))}
    </div>
  </div>

  <!-- ===== SOMMAIRE ===== -->
  <section id="cours" hidden>
    <button id="retour" class="retour">← Changer de matière</button>

    {matieres.map((m) => (
      <div class="bloc" data-matiere={m.id} hidden>
        <h1>{m.nom}</h1>
        <p class="muted">{m.description}</p>

        {m.chapitres.length === 0 ? (
          <p class="vide muted">Bientôt disponible.</p>
        ) : (
          m.chapitres.map((ch, i) => {
            // Uniquement les niveaux qui ont du contenu dans ce chapitre
            const colonnes = m.niveaux.filter((nv) => ch.niveaux[nv.id]?.length);
            const numeros = numeroterChapitre(ch);
            return (
              <details class="chapitre accordeon">
                <summary>
                  <span class="chapitre-entete">
                    <span class="chapitre-num">Chapitre {i + 1}</span>
                    <h2>{ch.titre}</h2>
                  </span>
                  <span class="chevron" aria-hidden="true">⌄</span>
                </summary>

                <div class="colonnes">
                  {colonnes.map((nv) => (
                    <div class="colonne">
                      <p class="niveau-label">{nv.nom}</p>
                      <ul class="lecons">
                        {ch.niveaux[nv.id].map((c) => {
                          const info = infosLecon(entreesLecons, m.id, ch.titre, c);
                          const numero = `${i + 1}.${numeros.get(c)}`;
                          return info
                            ? <li><a href={info.url}><span class="numero">{numero}</span> {c}</a></li>
                            : <li><span class="numero">{numero}</span> {c}</li>;
                        })}
                      </ul>
                    </div>
                  ))}
                </div>
              </details>
            );
          })
        )}
      </div>
    ))}
  </section>

  <style>
    .etape { margin: 2.5rem 0 1rem; text-transform: uppercase; letter-spacing: .1em; font-size: .8rem; }

    /* ----- Cartes matières ----- */
    .choix {
      display: grid; gap: 1.25rem;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    }
    .carte {
      font: inherit; color: var(--fg); background: none; cursor: pointer; text-align: left;
      display: flex; flex-direction: column; gap: .4rem;
      padding: 1.5rem; border: 1px solid var(--line); border-radius: 12px;
      transition: border-color .2s, box-shadow .2s;
    }
    .carte:hover { border-color: var(--accent); box-shadow: 0 4px 16px rgba(0, 0, 0, .3); }
    .carte .titre { font-size: 1.2rem; }
    .carte .sous-titre { color: var(--muted); font-size: .95rem; line-height: 1.5; }

    /* ----- Bouton retour ----- */
    .retour {
      font: inherit; font-size: .9rem; background: none; border: none; padding: 0;
      margin-bottom: 2rem; color: var(--muted); cursor: pointer; transition: color .2s;
    }
    .retour:hover { color: var(--fg); }

    /* ----- Chapitres (accordéon) ----- */
    .vide { margin-top: 2rem; }
    .chapitre { margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid var(--line); }
    .chapitre summary {
      display: flex; justify-content: space-between; align-items: center; gap: 1rem;
      cursor: pointer; list-style: none;
    }
    .chapitre summary::-webkit-details-marker { display: none; }
    .chapitre-entete { display: block; }
    .chapitre-num { color: var(--accent); font-size: .75rem; text-transform: uppercase; letter-spacing: .1em; }
    .chapitre h2 { margin: .2rem 0 0; font-size: 1.5rem; }
    .chapitre .chevron {
      color: var(--muted); font-size: 1.3rem; line-height: 1; flex-shrink: 0; transition: transform .25s;
    }
    .chapitre[open] .chevron { transform: rotate(180deg); }
    .chapitre summary:hover h2 { color: var(--accent); transition: color .2s; }
    .chapitre .colonnes { margin-top: 1.25rem; }

    /* ----- Colonnes par niveau ----- */
    .colonnes {
      display: grid; gap: 1rem;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    }
    .colonne { padding: 1.25rem; border: 1px solid var(--line); border-radius: 12px; }
    .niveau-label {
      margin: 0 0 .75rem; color: var(--accent);
      font-size: .75rem; text-transform: uppercase; letter-spacing: .1em;
    }
    .lecons { margin: 0; padding-left: 1.1rem; color: var(--muted); }
    .lecons li { padding: .25rem 0; }
    .lecons a { color: inherit; text-decoration: none; transition: color .2s; }
    .lecons a:hover { color: var(--accent); }
    .lecons .numero { color: var(--accent); font-variant-numeric: tabular-nums; }
  </style>

  <script>
    import gsap from "gsap";

    const $ = (s) => document.querySelectorAll(s);
    const choixMatiere = document.getElementById("choix-matiere");
    const cours = document.getElementById("cours");
    const retour = document.getElementById("retour");

    // Animation d'apparition réutilisable
    function apparaitre(elements, decalage = 15) {
      gsap.fromTo(elements,
        { y: decalage, opacity: 0 },
        { y: 0, opacity: 1, duration: .5, stagger: .05, ease: "power2.out", overwrite: true });
    }

    // Choix de la matière → affiche son sommaire
    $(".matiere").forEach((b) =>
      b.addEventListener("click", () => {
        const bloc = document.querySelector(`.bloc[data-matiere="${b.dataset.matiere}"]`);
        $(".bloc").forEach((x) => (x.hidden = x !== bloc));
        choixMatiere.hidden = true;
        cours.hidden = false;
        window.scrollTo({ top: 0, behavior: "smooth" });
        apparaitre([retour, ...bloc.querySelectorAll("h1, h1 + p, .vide, .chapitre")], 20);
      })
    );

    // Retour au choix de matière
    retour.addEventListener("click", () => {
      cours.hidden = true;
      choixMatiere.hidden = false;
      window.scrollTo({ top: 0 });
      apparaitre($(".matiere"));
    });
  </script>
</Layout>
