---
import Layout from "../layouts/Layout.astro";

// Une ligne par application : ajoutez-en au fur et à mesure
const applis = [
  { titre: "Générateur", texte: "Signaux périodiques et bruits colorés, avec forme d'onde et spectre.", href: "/applications/generateur" },
  { titre: "Synthèse additive", texte: "Construire un son harmonique par harmonique.", href: "/applications/synthese" },
  { titre: "Battements", texte: "Deux fréquences proches qui pulsent ensemble.", href: "/applications/battements" },
  { titre: "Oscilloscope micro", texte: "Forme d'onde et spectre en direct du micro.", href: "/applications/oscilloscope" },
];
---
<Layout title="Applications" description="Applications, jeux et exercices autour du son">
  <h1>Applications</h1>
  <p class="muted">Applications, jeux et exercices interactifs autour du son.</p>

  <div class="grille">
    {applis.map((a) => (
      <a class="carte" href={a.href}>
        <span class="titre">{a.titre}</span>
        <span class="sous-titre">{a.texte}</span>
        <span class="fleche">→</span>
      </a>
    ))}
  </div>

  <style>
    .grille {
      display: grid; gap: 1.25rem; margin-top: 2rem;
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    }
    .carte {
      aspect-ratio: 1;
      display: flex; flex-direction: column; gap: .4rem;
      padding: 1.5rem; border: 1px solid var(--line); border-radius: 12px;
      text-decoration: none; color: var(--fg);
      transition: border-color .2s, box-shadow .2s;
    }
    .carte:hover { border-color: var(--accent); box-shadow: 0 4px 16px rgba(0, 0, 0, .3); }
    .titre { font-size: 1.2rem; }
    .sous-titre { color: var(--muted); font-size: .95rem; line-height: 1.5; }
    .fleche { margin-top: auto; color: var(--accent); transition: transform .2s; }
    .carte:hover .fleche { transform: translateX(4px); }
  </style>

  <script>
    import gsap from "gsap";
    gsap.fromTo(".carte",
      { y: 20, opacity: 0 },
      { y: 0, opacity: 1, duration: .6, stagger: .08, ease: "power2.out" });
  </script>
</Layout>
