---
import Layout from "../../layouts/Layout.astro";
import Generateur from "../../components/Generateur.astro";
---
<Layout title="Générateur" description="Générateur de signaux périodiques et de bruits colorés">
  <a href="/applications" class="retour muted">← Applications</a>
  <h1>Générateur</h1>
  <p class="muted intro">Signaux périodiques et bruits colorés : observez la forme d'onde, le spectre, et écoutez.</p>

  <Generateur />

  <style>
    .retour { display: inline-block; margin-bottom: 1.5rem; text-decoration: none; font-size: .9rem; transition: color .2s; }
    .retour:hover { color: var(--fg); }
    .intro { margin: 0 0 2rem; }
  </style>
</Layout>
