---
// Figure principale de la représentation temporelle : axes temps/amplitude,
// une sinusoïde annotée (amplitude A, période T, niveau zéro).
// Le tracé est calculé point par point (vraie sinusoïde, pas une approximation
// à la Bézier à la main) pour que la courbe touche exactement les repères de
// crête/creux et que les côtes A et T correspondent à ce qui est dessiné.
// Utilisable dans une leçon .mdx :
// <SchemaAxesTemporels legende="..." />
interface Props {
  legende?: string;
}
const { legende } = Astro.props as Props;

const BASE = 95;       // niveau zéro (axe des abscisses)
const AMPL = 65;       // amplitude (distance zéro → crête/creux)
const X0 = 40;         // départ de la sinusoïde (phase 0)
const PERIODE = 120;   // une période, en pixels
const X1 = X0 + 2 * PERIODE; // deux périodes dessinées

const points = [];
for (let x = X0; x <= X1; x += 2) {
  const y = BASE - AMPL * Math.sin((2 * Math.PI * (x - X0)) / PERIODE);
  points.push(`${x.toFixed(1)} ${y.toFixed(1)}`);
}
const dOnde = `M ${points.join(" L ")}`;
---
<figure class="schema-axes-temporel">
  <svg viewBox="0 0 320 190" xmlns="http://www.w3.org/2000/svg" role="img" aria-label={legende ?? "Représentation temporelle d'un signal : axes temps et amplitude"}>
    <!-- repères horizontaux (zéro, crête, creux) -->
    <line x1="40" y1="95" x2="300" y2="95" class="niveau-zero" />
    <line x1="40" y1="30" x2="160" y2="30" class="niveau-repere" />
    <line x1="40" y1="160" x2="160" y2="160" class="niveau-repere" />

    <!-- axe amplitude (vertical) -->
    <line x1="40" y1="178" x2="40" y2="14" class="axe" marker-end="url(#pointe-axe)" />
    <text x="14" y="26" class="etiquette-axe">amplitude</text>

    <!-- axe temps (horizontal) -->
    <line x1="30" y1="95" x2="308" y2="95" class="axe" marker-end="url(#pointe-axe)" />
    <text x="290" y="112" class="etiquette-axe etiquette-centre">t</text>

    <!-- la forme d'onde (vraie sinusoïde échantillonnée) -->
    <path d={dOnde} class="onde" fill="none" />

    <!-- amplitude A -->
    <line x1="70" y1="30" x2="70" y2="95" class="cote" marker-start="url(#pointe-cote)" marker-end="url(#pointe-cote)" />
    <text x="78" y="64" class="etiquette">A</text>

    <!-- période T -->
    <line x1="40" y1="178" x2="160" y2="178" class="cote" marker-start="url(#pointe-cote)" marker-end="url(#pointe-cote)" />
    <text x="92" y="172" class="etiquette etiquette-centre">T</text>

    <defs>
      <marker id="pointe-axe" markerWidth="7" markerHeight="7" refX="5" refY="3.5" orient="auto">
        <path d="M0,0 L7,3.5 L0,7 Z" class="pointe" />
      </marker>
      <marker id="pointe-cote" markerWidth="6" markerHeight="6" refX="3" refY="3" orient="auto">
        <path d="M0,0 L6,3 L0,6 Z" class="pointe-cote-fill" />
      </marker>
    </defs>
  </svg>
  {legende && <figcaption>{legende}</figcaption>}
</figure>

<style>
  .schema-axes-temporel {
    margin: 0;
    border: 1px solid var(--line);
    border-radius: 12px;
    overflow: hidden;
    background: color-mix(in srgb, var(--bg) 92%, white 8%);
  }
  .schema-axes-temporel svg { display: block; width: 100%; height: auto; }
  .schema-axes-temporel figcaption {
    padding: .6rem .9rem;
    border-top: 1px solid var(--line);
    font-size: .82rem;
    color: var(--muted);
    text-align: center;
  }

  .axe { stroke: var(--fg); stroke-width: 1.4; }
  .pointe { fill: var(--fg); }
  .onde { stroke: var(--accent); stroke-width: 2.4; stroke-linejoin: round; stroke-linecap: round; }
  .niveau-zero { stroke: var(--muted); stroke-width: 1; stroke-dasharray: 2 3; opacity: .6; }
  .niveau-repere { stroke: var(--muted); stroke-width: 1; stroke-dasharray: 2 3; opacity: .4; }
  .cote { stroke: var(--muted); stroke-width: 1; }
  .pointe-cote-fill { fill: var(--muted); }
  .etiquette { fill: var(--fg); font-size: 12px; }
  .etiquette-axe { fill: var(--fg); font-size: 11px; }
  .etiquette-centre { text-anchor: middle; }
</style>
