---
// Échelle des mels : mel = 2595 · log10(1 + f / 700) (Stevens, Volkman & Newman, 1937)
// Tracé de la hauteur perçue (mels) en fonction de la fréquence (Hz) : la courbe
// s'aplatit nettement au-delà de ~1000 Hz — l'oreille "tasse" les aigus.
// Utilisable dans une leçon .mdx :
// <CourbeMel legende="..." />
interface Props {
  legende?: string;
}
const { legende } = Astro.props as Props;

const melDe = (f: number) => 2595 * Math.log10(1 + f / 700);

const FMAX = 10000;
const MELMAX = melDe(FMAX); // ≈ 3073

const X0 = 46, X1 = 318, Y0 = 164, Y1 = 22;
const xDe = (f: number) => X0 + (f / FMAX) * (X1 - X0);
const yDe = (m: number) => Y0 - (m / MELMAX) * (Y0 - Y1);

const points = [];
for (let f = 0; f <= FMAX; f += 100) {
  points.push(`${xDe(f).toFixed(1)},${yDe(melDe(f)).toFixed(1)}`);
}
const dCourbe = `M ${points.join(" L ")}`;

// droite de référence y = x (si l'échelle était linéaire sur tout le spectre)
const dDiagonale = `M ${xDe(0)},${yDe(0)} L ${xDe(FMAX)},${yDe(FMAX)}`;

const graduationsX = [0, 2000, 4000, 6000, 8000, 10000];
---
<figure class="courbe-mel">
  <svg viewBox="0 0 340 200" xmlns="http://www.w3.org/2000/svg" role="img" aria-label={legende ?? "Hauteur perçue en mels en fonction de la fréquence en Hz"}>
    {graduationsX.map((f) => (
      <line x1={xDe(f)} y1={Y0} x2={xDe(f)} y2={Y1} class="grille" />
    ))}
    <line x1={X0} y1={Y0} x2={X1} y2={Y0} class="axe" />
    <line x1={X0} y1={Y0} x2={X0} y2={Y1 - 6} class="axe" />

    {graduationsX.map((f) => (
      <>
        <line x1={xDe(f)} y1={Y0} x2={xDe(f)} y2={Y0 + 4} class="tick" />
        <text x={xDe(f)} y={Y0 + 16} class="etiquette-x etiquette-centre">{f}</text>
      </>
    ))}

    <path d={dDiagonale} class="diagonale" fill="none" />
    <path d={dCourbe} class="courbe" fill="none" />

    <!-- repère 1000 Hz = 1000 mel -->
    <circle cx={xDe(1000)} cy={yDe(1000)} r="3" class="point-repere" />
    <text x={xDe(1000) + 6} y={yDe(1000) - 6} class="etiquette-repere">1000 Hz = 1000 mel</text>

    <text x={(X0 + X1) / 2} y="194" class="etiquette-axe etiquette-centre">fréquence (Hz)</text>
    <text x="14" y="18" class="etiquette-axe">mel</text>
    <text x={X1 - 4} y={yDe(FMAX) - 4} class="etiquette-diagonale etiquette-droite">échelle linéaire (référence)</text>
  </svg>
  {legende && <figcaption>{legende}</figcaption>}
</figure>

<style>
  .courbe-mel {
    margin: 0;
    border: 1px solid var(--line);
    border-radius: 12px;
    overflow: hidden;
    background: color-mix(in srgb, var(--bg) 92%, white 8%);
  }
  .courbe-mel svg { display: block; width: 100%; height: auto; }
  .courbe-mel figcaption {
    padding: .6rem .9rem;
    border-top: 1px solid var(--line);
    font-size: .82rem;
    color: var(--muted);
    text-align: center;
  }
  .grille { stroke: var(--line); stroke-width: .6; opacity: .4; }
  .axe { stroke: var(--fg); stroke-width: 1.2; }
  .tick { stroke: var(--fg); stroke-width: 1; }
  .courbe { stroke: var(--accent); stroke-width: 2.2; stroke-linejoin: round; stroke-linecap: round; }
  .diagonale { stroke: var(--muted); stroke-width: 1; stroke-dasharray: 3 3; opacity: .6; }
  .point-repere { fill: var(--accent); }
  .etiquette-repere { fill: var(--fg); font-size: 9px; }
  .etiquette-x { fill: var(--muted); font-size: 9px; }
  .etiquette-axe { fill: var(--fg); font-size: 10px; }
  .etiquette-diagonale { fill: var(--muted); font-size: 8px; }
  .etiquette-centre { text-anchor: middle; }
  .etiquette-droite { text-anchor: end; }
</style>
