---
// Seuil différentiel de fréquence (Δf/f, en %) en fonction de la fréquence
// du son pur testé — forme en "U" caractéristique, meilleure résolution
// autour de 500 Hz - 2 kHz, moins bonne vers les graves et les aigus extrêmes.
// Utilisable dans une leçon .mdx :
// <CourbeDiscrimination legende="..." />
interface Props {
  legende?: string;
}
const { legende } = Astro.props as Props;

// Points approximatifs (fréquence en Hz, seuil en % de la fréquence)
const donnees: [number, number][] = [
  [50, 1.0],
  [100, 0.6],
  [200, 0.35],
  [500, 0.2],
  [1000, 0.2],
  [2000, 0.25],
  [5000, 0.6],
  [10000, 1.5],
];

const X0 = 46, X1 = 318, Y0 = 164, Y1 = 22;
const logMin = Math.log10(50), logMax = Math.log10(10000);
const xDe = (f: number) => X0 + ((Math.log10(f) - logMin) / (logMax - logMin)) * (X1 - X0);
const yDe = (v: number) => Y0 - (v / 2.0) * (Y0 - Y1);

const points = donnees.map(([f, v]) => `${xDe(f).toFixed(1)},${yDe(v).toFixed(1)}`);
const dCourbe = `M ${points.join(" L ")}`;

const graduationsX = [50, 100, 200, 500, 1000, 2000, 5000, 10000];
const graduationsY = [0, 0.5, 1.0, 1.5, 2.0];
---
<figure class="courbe-discrimination">
  <svg viewBox="0 0 340 200" xmlns="http://www.w3.org/2000/svg" role="img" aria-label={legende ?? "Seuil différentiel de fréquence en fonction de la fréquence"}>
    <!-- grille horizontale -->
    {graduationsY.map((v) => (
      <line x1={X0} y1={yDe(v)} x2={X1} y2={yDe(v)} class="grille" />
    ))}
    <!-- zone de meilleure discrimination -->
    <rect x={xDe(500)} y={Y1} width={xDe(2000) - xDe(500)} height={Y0 - Y1} class="zone" />

    <!-- axes -->
    <line x1={X0} y1={Y0} x2={X1} y2={Y0} class="axe" />
    <line x1={X0} y1={Y0} x2={X0} y2={Y1 - 6} class="axe" />

    <!-- graduations X -->
    {graduationsX.map((f) => (
      <>
        <line x1={xDe(f)} y1={Y0} x2={xDe(f)} y2={Y0 + 4} class="tick" />
        <text x={xDe(f)} y={Y0 + 16} class="etiquette-x">{f >= 1000 ? `${f / 1000}k` : f}</text>
      </>
    ))}
    <!-- graduations Y -->
    {graduationsY.map((v) => (
      <text x={X0 - 6} y={yDe(v) + 3} class="etiquette-y">{v.toFixed(1)}</text>
    ))}

    <!-- courbe -->
    <path d={dCourbe} class="courbe" fill="none" />
    {donnees.map(([f, v]) => <circle cx={xDe(f)} cy={yDe(v)} r="2.6" class="point" />)}

    <text x={(xDe(500) + xDe(2000)) / 2} y={Y1 + 14} class="etiquette-zone etiquette-centre">meilleure résolution</text>
    <text x={(X0 + X1) / 2} y="194" class="etiquette-axe etiquette-centre">fréquence (Hz, échelle log)</text>
    <text x="14" y="18" class="etiquette-axe">Δf/f (%)</text>
  </svg>
  {legende && <figcaption>{legende}</figcaption>}
</figure>

<style>
  .courbe-discrimination {
    margin: 0;
    border: 1px solid var(--line);
    border-radius: 12px;
    overflow: hidden;
    background: color-mix(in srgb, var(--bg) 92%, white 8%);
  }
  .courbe-discrimination svg { display: block; width: 100%; height: auto; }
  .courbe-discrimination figcaption {
    padding: .6rem .9rem;
    border-top: 1px solid var(--line);
    font-size: .82rem;
    color: var(--muted);
    text-align: center;
  }
  .grille { stroke: var(--line); stroke-width: .6; opacity: .5; }
  .zone { fill: color-mix(in srgb, var(--accent) 10%, transparent); }
  .axe { stroke: var(--fg); stroke-width: 1.2; }
  .tick { stroke: var(--fg); stroke-width: 1; }
  .courbe { stroke: var(--accent); stroke-width: 2.2; stroke-linejoin: round; stroke-linecap: round; }
  .point { fill: var(--accent); }
  .etiquette-x, .etiquette-y { fill: var(--muted); font-size: 9px; }
  .etiquette-y { text-anchor: end; }
  .etiquette-axe { fill: var(--fg); font-size: 10px; }
  .etiquette-zone { fill: var(--accent); font-size: 9px; }
  .etiquette-centre { text-anchor: middle; }
</style>
