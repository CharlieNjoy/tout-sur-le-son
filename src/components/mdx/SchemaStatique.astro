---
// Schéma fixe (SVG, pas d'animation) représentant le principe de base d'un
// phénomène sonore. Utilisable dans une leçon .mdx :
// <SchemaStatique type="attenuation" slot="figure" legende="..." />
interface Props {
  type:
    | "attenuation"
    | "absorption"
    | "sommation-interferences"
    | "diffusion"
    | "diffraction"
    | "refraction"
    | "reflexion"
    | "transmission"
    | "resonance";
  legende?: string;
}
const { type, legende } = Astro.props as Props;
---
<figure class="schema-statique">
  <svg viewBox="0 0 240 170" xmlns="http://www.w3.org/2000/svg" role="img" aria-label={legende}>
    {type === "attenuation" && (
      <>
        <circle cx="34" cy="85" r="4" class="source" />
        <circle cx="34" cy="85" r="28" class="onde onde-1" />
        <circle cx="34" cy="85" r="60" class="onde onde-2" />
        <circle cx="34" cy="85" r="96" class="onde onde-3" />
        <text x="66" y="68" class="etiquette">I</text>
        <text x="98" y="58" class="etiquette-faible">I / 4</text>
        <text x="138" y="48" class="etiquette-tres-faible">I / 16</text>
      </>
    )}

    {type === "absorption" && (
      <>
        <circle cx="30" cy="85" r="4" class="source" />
        <path d="M 30 85 A 26 26 0 0 1 56 85" class="onde onde-1" fill="none" />
        <path d="M 30 85 A 52 52 0 0 1 82 85" class="onde onde-2" fill="none" />
        <rect x="150" y="20" width="40" height="130" class="materiau" />
        <path d="M150 35 l14 14 M150 55 l14 14 M150 75 l14 14 M150 95 l14 14 M150 115 l14 14 M150 135 l10 10" class="hachures" />
        <path d="M100 85 h40" class="fleche" marker-end="url(#fleche-pointe)" />
        <path d="M160 60 q6 -8 0 -16 M172 60 q6 -8 0 -16 M160 112 q6 8 0 16 M172 112 q6 8 0 16" class="dissipation" />
        <text x="170" y="12" class="etiquette etiquette-centre">matériau</text>
      </>
    )}

    {type === "sommation-interferences" && (
      <>
        <text x="60" y="16" class="etiquette etiquette-centre">en phase</text>
        <path d="M10 40 Q 22 25 35 40 T 60 40 T 85 40 T 110 40" class="onde-fine" fill="none" />
        <path d="M10 48 Q 22 33 35 48 T 60 48 T 85 48 T 110 48" class="onde-fine" fill="none" />
        <text x="60" y="64" class="etiquette-faible etiquette-centre">s'additionnent</text>
        <path d="M10 85 Q 22 60 35 85 T 60 85 T 85 85 T 110 85" class="onde onde-1" fill="none" />

        <line x1="120" y1="5" x2="120" y2="150" class="separation" />

        <text x="180" y="16" class="etiquette etiquette-centre">en opposition</text>
        <path d="M130 40 Q 142 25 155 40 T 180 40 T 205 40 T 230 40" class="onde-fine" fill="none" />
        <path d="M130 48 Q 142 63 155 48 T 180 48 T 205 48 T 230 48" class="onde-fine" fill="none" />
        <text x="180" y="72" class="etiquette-faible etiquette-centre">s'annulent</text>
        <line x1="130" y1="90" x2="230" y2="90" class="onde onde-1" />
      </>
    )}

    {type === "diffusion" && (
      <>
        <text x="60" y="16" class="etiquette etiquette-centre">lisse</text>
        <line x1="20" y1="110" x2="100" y2="110" class="materiau-ligne" />
        <path d="M30 40 L55 100" class="fleche" marker-end="url(#fleche-pointe)" />
        <path d="M55 100 L80 40" class="fleche" marker-end="url(#fleche-pointe)" />

        <text x="180" y="16" class="etiquette etiquette-centre">irrégulière</text>
        <path d="M140 110 l10 -14 l10 10 l10 -18 l10 12 l10 -10 l10 14 l10 -8" class="materiau-ligne" fill="none" />
        <path d="M170 45 L172 95" class="fleche" marker-end="url(#fleche-pointe)" />
        <path d="M172 95 L140 70" class="fleche-faible" marker-end="url(#fleche-pointe-faible)" />
        <path d="M172 95 L205 65" class="fleche-faible" marker-end="url(#fleche-pointe-faible)" />
        <path d="M172 95 L195 115" class="fleche-faible" marker-end="url(#fleche-pointe-faible)" />
        <path d="M172 95 L150 125" class="fleche-faible" marker-end="url(#fleche-pointe-faible)" />
      </>
    )}

    {type === "diffraction" && (
      <>
        <line x1="90" y1="10" x2="90" y2="65" class="materiau-ligne" stroke-width="5" />
        <line x1="90" y1="95" x2="90" y2="160" class="materiau-ligne" stroke-width="5" />
        <path d="M10 30 V 140 M30 30 V 140 M50 30 V 140" class="onde-fine" />
        <path d="M 90 80 m -20 0 a 20 20 0 0 0 40 0" class="onde onde-1" fill="none" />
        <path d="M 90 80 m -45 0 a 45 45 0 0 0 90 0" class="onde onde-2" fill="none" />
        <path d="M 90 80 m -72 0 a 72 72 0 0 0 144 0" class="onde onde-3" fill="none" />
        <text x="30" y="20" class="etiquette">onde</text>
        <text x="150" y="40" class="etiquette-faible">« ombre » éclairée</text>
      </>
    )}

    {type === "refraction" && (
      <>
        <rect x="0" y="85" width="240" height="75" class="milieu-2" />
        <line x1="0" y1="85" x2="240" y2="85" class="separation-forte" />
        <line x1="120" y1="20" x2="120" y2="160" class="normale" />
        <line x1="120" y1="85" x2="55" y2="20" class="onde onde-1" marker-end="url(#fleche-pointe)" />
        <line x1="120" y1="85" x2="160" y2="160" class="onde onde-1" marker-end="url(#fleche-pointe)" />
        <path d="M110 55 A 36 36 0 0 1 97 38" class="angle" fill="none" />
        <text x="100" y="48" class="etiquette-petite">θ₁</text>
        <path d="M130 108 A 28 28 0 0 0 142 123" class="angle" fill="none" />
        <text x="138" y="112" class="etiquette-petite">θ₂</text>
        <text x="60" y="35" class="etiquette-faible">milieu 1</text>
        <text x="170" y="140" class="etiquette-faible">milieu 2</text>
      </>
    )}

    {type === "reflexion" && (
      <>
        <line x1="10" y1="130" x2="230" y2="130" class="materiau-ligne" stroke-width="4" />
        <line x1="120" y1="20" x2="120" y2="130" class="normale" />
        <line x1="50" y1="30" x2="120" y2="130" class="onde onde-1" marker-end="url(#fleche-pointe)" />
        <line x1="120" y1="130" x2="190" y2="30" class="onde onde-1" marker-end="url(#fleche-pointe)" />
        <path d="M100 95 A 42 42 0 0 1 108 56" class="angle" fill="none" />
        <text x="90" y="80" class="etiquette-petite">θᵢ</text>
        <path d="M132 56 A 42 42 0 0 1 140 95" class="angle" fill="none" />
        <text x="140" y="80" class="etiquette-petite">θᵣ</text>
        <text x="120" y="150" class="etiquette-faible etiquette-centre">θᵢ = θᵣ</text>
      </>
    )}

    {type === "transmission" && (
      <>
        <rect x="105" y="15" width="30" height="140" class="materiau" />
        <line x1="20" y1="85" x2="95" y2="85" class="onde onde-1" marker-end="url(#fleche-pointe)" />
        <line x1="95" y1="85" x2="30" y2="45" class="onde-faible" marker-end="url(#fleche-pointe-faible)" />
        <path d="M112 55 q6 -8 0 -16 M124 55 q6 -8 0 -16 M112 115 q6 8 0 16 M124 115 q6 8 0 16" class="dissipation" />
        <line x1="140" y1="85" x2="220" y2="85" class="onde-tres-faible" marker-end="url(#fleche-pointe-tres-faible)" />
        <text x="45" y="35" class="etiquette-petite">réfléchi</text>
        <text x="120" y="12" class="etiquette-petite etiquette-centre">absorbé</text>
        <text x="180" y="75" class="etiquette-petite">transmis</text>
      </>
    )}

    {type === "resonance" && (
      <>
        <line x1="40" y1="30" x2="40" y2="140" class="materiau-ligne" stroke-width="4" />
        <line x1="40" y1="30" x2="200" y2="30" class="materiau-ligne" stroke-width="3" />
        <line x1="40" y1="140" x2="200" y2="140" class="materiau-ligne" stroke-width="3" />
        <path d="M40 85 Q 86 20 132 85 T 200 85" class="onde onde-1" fill="none" />
        <circle cx="40" cy="85" r="3" class="source" />
        <text x="30" y="20" class="etiquette-petite">fermé (nœud)</text>
        <text x="175" y="20" class="etiquette-petite">ouvert (ventre)</text>
      </>
    )}

    <defs>
      <marker id="fleche-pointe" markerWidth="8" markerHeight="8" refX="4" refY="4" orient="auto">
        <path d="M0,0 L8,4 L0,8 Z" class="pointe" />
      </marker>
      <marker id="fleche-pointe-faible" markerWidth="8" markerHeight="8" refX="4" refY="4" orient="auto">
        <path d="M0,0 L8,4 L0,8 Z" class="pointe-faible" />
      </marker>
      <marker id="fleche-pointe-tres-faible" markerWidth="8" markerHeight="8" refX="4" refY="4" orient="auto">
        <path d="M0,0 L8,4 L0,8 Z" class="pointe-tres-faible" />
      </marker>
    </defs>
  </svg>
  {legende && <figcaption>{legende}</figcaption>}
</figure>

<style>
  .schema-statique {
    margin: 0;
    border: 1px solid var(--line);
    border-radius: 12px;
    overflow: hidden;
    background: color-mix(in srgb, var(--bg) 92%, white 8%);
  }
  .schema-statique svg { display: block; width: 100%; height: auto; }
  .schema-statique figcaption {
    padding: .6rem .9rem;
    border-top: 1px solid var(--line);
    font-size: .82rem;
    color: var(--muted);
    text-align: center;
  }

  .source { fill: var(--accent); }
  .onde { stroke: var(--accent); stroke-width: 2; fill: none; }
  .onde-1 { opacity: 1; }
  .onde-2 { opacity: .55; }
  .onde-3 { opacity: .28; }
  .onde-fine { stroke: var(--accent); stroke-width: 1.3; opacity: .7; }
  .onde-faible { stroke: var(--accent); stroke-width: 2; opacity: .45; }
  .onde-tres-faible { stroke: var(--accent); stroke-width: 2; opacity: .2; }

  .materiau { fill: color-mix(in srgb, var(--muted) 20%, transparent); stroke: var(--line); }
  .materiau-ligne { stroke: var(--line); stroke-width: 2; fill: none; }
  .hachures { stroke: var(--muted); stroke-width: 1; opacity: .6; }
  .dissipation { stroke: var(--muted); stroke-width: 1.3; fill: none; opacity: .75; }

  .fleche { stroke: var(--accent); stroke-width: 2; }
  .fleche-faible { stroke: var(--accent); stroke-width: 1.4; opacity: .55; }
  .pointe { fill: var(--accent); }
  .pointe-faible { fill: var(--accent); opacity: .55; }
  .pointe-tres-faible { fill: var(--accent); opacity: .2; }

  .normale { stroke: var(--muted); stroke-width: 1; stroke-dasharray: 4 3; }
  .separation { stroke: var(--line); stroke-width: 1; stroke-dasharray: 3 3; }
  .separation-forte { stroke: var(--line); stroke-width: 1.5; }
  .milieu-2 { fill: color-mix(in srgb, var(--accent) 6%, transparent); }
  .angle { stroke: var(--muted); stroke-width: 1; }

  .etiquette { fill: var(--fg); font-size: 11px; }
  .etiquette-faible { fill: var(--muted); font-size: 10px; }
  .etiquette-tres-faible { fill: var(--muted); font-size: 9px; opacity: .7; }
  .etiquette-petite { fill: var(--muted); font-size: 9px; }
  .etiquette-centre { text-anchor: middle; }
</style>
