---
// Animation : molécules d'air en agitation permanente (même sans aucun son).
// Utilisable dans n'importe quelle leçon .mdx : <MoleculesAgitation legende="..." />
const { legende = "Molécules d'air en agitation permanente." } = Astro.props;
---
<figure class="ecran-anim">
  <canvas class="anim-molecules"></canvas>
  <figcaption>{legende}</figcaption>
</figure>

<style>
  .ecran-anim { margin: 0; border: 1px solid var(--line); border-radius: 12px; overflow: hidden; }
  .ecran-anim canvas { display: block; width: 100%; height: 190px; }
  .ecran-anim figcaption {
    padding: .6rem .9rem;
    border-top: 1px solid var(--line);
    font-size: .82rem;
    color: var(--muted);
    text-align: center;
  }
</style>

<script>
  function demarrer(canvas) {
    const ctx = canvas.getContext("2d");
    const styles = getComputedStyle(document.documentElement);
    const ACCENT = styles.getPropertyValue("--accent").trim();
    const MUTED = styles.getPropertyValue("--muted").trim();

    let particules = [];
    function construire() {
      const w = canvas.clientWidth, h = canvas.clientHeight;
      const colonnes = Math.round(w / 26), lignes = Math.round(h / 26);
      particules = [];
      for (let i = 0; i < colonnes; i++) {
        for (let j = 0; j < lignes; j++) {
          particules.push({
            x0: ((i + 0.5) / colonnes) * w,
            y0: ((j + 0.5) / lignes) * h,
            angle: Math.random() * Math.PI * 2,
            vitesse: 0.4 + Math.random() * 0.5,
            accent: Math.random() < 0.18,
          });
        }
      }
    }
    function redim() {
      const r = canvas.getBoundingClientRect();
      canvas.width = r.width * devicePixelRatio;
      canvas.height = r.height * devicePixelRatio;
      ctx.setTransform(devicePixelRatio, 0, 0, devicePixelRatio, 0, 0);
      construire();
    }
    new ResizeObserver(redim).observe(canvas);
    redim();

    function dessiner() {
      const w = canvas.clientWidth, h = canvas.clientHeight;
      ctx.clearRect(0, 0, w, h);
      for (const p of particules) {
        // Petite marche aléatoire bornée autour de la position de repos
        p.angle += (Math.random() - 0.5) * 0.6;
        p.x = (p.x ?? p.x0) + Math.cos(p.angle) * p.vitesse;
        p.y = (p.y ?? p.y0) + Math.sin(p.angle) * p.vitesse;
        p.x += (p.x0 - p.x) * 0.02; // rappel doux vers la position de repos
        p.y += (p.y0 - p.y) * 0.02;

        ctx.beginPath();
        ctx.fillStyle = p.accent ? ACCENT : MUTED;
        ctx.globalAlpha = p.accent ? 0.85 : 0.45;
        ctx.arc(p.x, p.y, 2, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.globalAlpha = 1;
      requestAnimationFrame(dessiner);
    }
    requestAnimationFrame(dessiner);
  }

  document.querySelectorAll(".anim-molecules").forEach(demarrer);
</script>
